    <region left="20" top="4642" width="470" height="35" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- gate power parts sum to P.G (check):</p>
      </content>
    </text>
    </region>
    <region left="510" top="4642" width="1080" height="35" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="4">
      <input>
        <e type="operand">P.sum</e>
        <e type="operand">P.drv_on</e>
        <e type="operand">P.drv_off</e>
        <e type="operator" args="2">+</e>
        <e type="operand">n.par</e>
        <e type="operand">P.Ron</e>
        <e type="operand">P.Roff</e>
        <e type="operator" args="2">+</e>
        <e type="bracket">(</e>
        <e type="operator" args="2">*</e>
        <e type="operator" args="2">+</e>
        <e type="operand">P.Rgi</e>
        <e type="operator" args="2">+</e>
        <e type="operand">P.D_off</e>
        <e type="operator" args="2">+</e>
        <e type="operator" args="2">:</e>
      </input>
        <contract>
          <e type="operand" style="unit">W</e>
        </contract>
        <result action="numeric">
          <e type="operand">0.3213</e>
        </result>
    </math>
    </region>
    <region left="20" top="4701" width="1560" height="27" color="#0f2a44" fontSize="12" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: bold; font-style: normal; font-size: 12px;">6  Driver limits and junction temperature</p>
      </content>
    </text>
    </region>
    <region left="20" top="4736" width="470" height="53" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- V.H above the VH UVLO turn-on threshold (&gt;1):</p>
      </content>
    </text>
    </region>
    <region left="510" top="4736" width="1080" height="53" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="3">
      <input>
        <e type="operand">k.UVLO</e>
        <e type="operand">V.H</e>
        <e type="operand">V.H_on</e>
        <e type="operator" args="2">/</e>
        <e type="operator" args="2">:</e>
      </input>
        <result action="numeric">
          <e type="operand">1.259</e>
        </result>
    </math>
    </region>
    <region left="20" top="4797" width="470" height="53" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- f.sw under the driver maximum (&gt;1):</p>
      </content>
    </text>
    </region>
    <region left="510" top="4797" width="1080" height="53" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="2">
      <input>
        <e type="operand">k.fsw</e>
        <e type="operand">f.max</e>
        <e type="operand">f.sw</e>
        <e type="operator" args="2">/</e>
        <e type="operator" args="2">:</e>
      </input>
        <result action="numeric">
          <e type="operand">11.76</e>
        </result>
    </math>
    </region>
    <region left="20" top="4858" width="470" height="53" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- Junction rise [C]:</p>
      </content>
    </text>
    </region>
    <region left="510" top="4858" width="1080" height="53" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="1">
      <input>
        <e type="operand">ΔT.j</e>
        <e type="operand">P.D</e>
        <e type="operand" style="unit">W</e>
        <e type="operator" args="2">/</e>
        <e type="operand">R.th_JA</e>
        <e type="operator" args="2">*</e>
        <e type="operator" args="2">:</e>
      </input>
        <result action="numeric">
          <e type="operand">12.3</e>
        </result>
    </math>
    </region>
    <region left="20" top="4919" width="470" height="35" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">Ambient temperature 1 [C]:</p>
      </content>
    </text>
    </region>
    <region left="510" top="4919" width="1080" height="35" color="#000000" bgColor="#ffff80" fontSize="8" isBreakable="false">
    <math>
      <input>
        <e type="operand">T.amb1</e>
        <e type="operand">25</e>
        <e type="operator" args="2">:</e>
      </input>
    </math>
    </region>
    <region left="20" top="4962" width="470" height="35" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- Junction temperature at T.amb1 [C]:</p>
      </content>
    </text>
    </region>
    <region left="510" top="4962" width="1080" height="35" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="1">
      <input>
        <e type="operand">T.j1</e>
        <e type="operand">T.amb1</e>
        <e type="operand">ΔT.j</e>
        <e type="operator" args="2">+</e>
        <e type="operator" args="2">:</e>
      </input>
        <result action="numeric">
          <e type="operand">37.3</e>
        </result>
    </math>
    </region>
    <region left="20" top="5005" width="470" height="35" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">Ambient temperature 2 [C]:</p>
      </content>
    </text>
    </region>
    <region left="510" top="5005" width="1080" height="35" color="#000000" bgColor="#ffff80" fontSize="8" isBreakable="false">
    <math>
      <input>
        <e type="operand">T.amb2</e>
        <e type="operand">45</e>
        <e type="operator" args="2">:</e>
      </input>
    </math>
    </region>
    <region left="20" top="5048" width="470" height="35" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- Junction temperature at T.amb2 [C]:</p>
      </content>
    </text>
    </region>
    <region left="510" top="5048" width="1080" height="35" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="1">
      <input>
        <e type="operand">T.j2</e>
        <e type="operand">T.amb2</e>
        <e type="operand">ΔT.j</e>
        <e type="operator" args="2">+</e>
        <e type="operator" args="2">:</e>
      </input>
        <result action="numeric">
          <e type="operand">57.3</e>
        </result>
    </math>
    </region>
    <region left="20" top="5091" width="470" height="53" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- margin to T.j_max at T.amb2 (&gt;1):</p>
      </content>
    </text>
    </region>
    <region left="510" top="5091" width="1080" height="53" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="2">
      <input>
        <e type="operand">k.Tj2</e>
        <e type="operand">T.j_max</e>
        <e type="operand">T.amb2</e>
        <e type="operator" args="2">-</e>
        <e type="operand">ΔT.j</e>
        <e type="operator" args="2">/</e>
        <e type="operator" args="2">:</e>
      </input>
        <result action="numeric">
          <e type="operand">6.48</e>
        </result>
    </math>
    </region>
    <region left="20" top="5152" width="470" height="35" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- Highest ambient the driver allows [C]:</p>
      </content>
    </text>
    </region>
    <region left="510" top="5152" width="1080" height="35" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="1">
      <input>
        <e type="operand">T.amb_max</e>
        <e type="operand">T.j_max</e>
        <e type="operand">ΔT.j</e>
        <e type="operator" args="2">-</e>
        <e type="operator" args="2">:</e>
      </input>
        <result action="numeric">
          <e type="operand">112.7</e>
        </result>
    </math>
    </region>
    <region left="20" top="5195" width="1560" height="51" color="#444444" fontSize="9" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 9px;">Unused functions (DS Table 8): without desaturation protection connect DESAT to GNDISO and leave DIAG floating; without the Miller clamp leave CLAMPdrv floating. SOFTOFF goes to VL only if BOTH are unused - with the Miller clamp it must go to the gate</p>
        <p style="font-weight: normal; font-style: normal; font-size: 9px;">through a resistor of at least 10 ohm (EVL board R19 10 ohm).</p>
      </content>
    </text>
    </region>
  </regions>
</worksheet>
