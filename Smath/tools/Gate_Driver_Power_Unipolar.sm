        <e type="operator" args="2">:</e>
      </input>
        <contract>
          <e type="operand" style="unit">W</e>
        </contract>
        <result action="numeric">
          <e type="operand">0.1523</e>
        </result>
    </math>
    </region>
    <region left="20" top="3218" width="470" height="71" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- Driver dissipation at turn-on:</p>
