      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 9px;">the diode branch carries about R.g_on / (R.g_on + R.g_off) of the turn-off charge.</p>
      </content>
    </text>
    </region>
    <region left="20" top="3035" width="470" height="53" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- D.off average current:</p>
      </content>
    </text>
    </region>
    <region left="510" top="3035" width="1080" height="53" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="2">
      <input>
        <e type="operand">I.avg_D</e>
        <e type="operand">n.par</e>
        <e type="operand">Q.g</e>
        <e type="operator" args="2">*</e>
        <e type="operand">f.sw</e>
        <e type="operator" args="2">*</e>
        <e type="operand">R.g_on</e>
        <e type="operator" args="2">*</e>
        <e type="operand">R.g_on</e>
        <e type="operand">R.g_off</e>
        <e type="operator" args="2">+</e>
        <e type="operator" args="2">/</e>
        <e type="operator" args="2">:</e>
      </input>
        <contract>
          <e type="operand" style="unit">mA</e>
        </contract>
        <result action="numeric">
          <e type="operand">11.90</e>
        </result>
    </math>
    </region>
    <region left="20" top="3096" width="470" height="53" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- diode average current margin (&gt;1):</p>
