        <e type="operand">I.avg_D</e>
        <e type="operator" args="2">/</e>
        <e type="operator" args="2">:</e>
      </input>
        <result action="numeric">
          <e type="operand">12.61</e>
        </result>
    </math>
    </region>
    <region left="20" top="3157" width="470" height="53" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- Turn-off energy left for the resistors, per second:</p>
      </content>
