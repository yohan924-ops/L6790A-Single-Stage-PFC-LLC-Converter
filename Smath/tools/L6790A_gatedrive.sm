    <region left="510" top="3995" width="1080" height="35" color="#000000" bgColor="#ffff80" fontSize="8" isBreakable="false">
    <math>
      <input>
        <e type="operand">C.boot</e>
        <e type="operand">470</e>
        <e type="operand" style="unit">nF</e>
        <e type="operator" args="2">*</e>
        <e type="operator" args="2">:</e>
      </input>
    </math>
    </region>
    <region left="20" top="4038" width="470" height="35" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">[PICK] Bootstrap resistor R.boot (0 = none):</p>
      </content>
    </text>
    </region>
    <region left="510" top="4038" width="1080" height="35" color="#000000" bgColor="#ffff80" fontSize="8" isBreakable="false">
