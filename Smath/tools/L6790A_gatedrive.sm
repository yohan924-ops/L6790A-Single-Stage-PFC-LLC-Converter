      <input>
        <e type="operand">R.boot</e>
        <e type="operand">0</e>
        <e type="operand" style="unit">ohm</e>
        <e type="operator" args="2">*</e>
        <e type="operator" args="2">:</e>
      </input>
    </math>
    </region>
    <region left="20" top="4097" width="1560" height="27" color="#0f2a44" fontSize="12" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: bold; font-style: normal; font-size: 12px;">7  Working rows (CC 88-167)</p>
      </content>
    </text>
    </region>
    <region left="20" top="4132" width="470" height="35" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- Gate capacitance per position, n.par C.g + C.gs:</p>
      </content>
    </text>
    </region>
    <region left="510" top="4132" width="1080" height="35" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="2">
      <input>
        <e type="operand">C.G</e>
        <e type="operand">n.par</e>
        <e type="operand">C.g</e>
        <e type="operator" args="2">*</e>
        <e type="operand">C.gs</e>
        <e type="operator" args="2">+</e>
        <e type="operator" args="2">:</e>
      </input>
        <contract>
          <e type="operand" style="unit">nF</e>
        </contract>
        <result action="numeric">
          <e type="operand">7.50</e>
        </result>
    </math>
    </region>
    <region left="20" top="4175" width="470" height="53" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- Internal gate resistance per position:</p>
      </content>
    </text>
    </region>
    <region left="510" top="4175" width="1080" height="53" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="2">
      <input>
        <e type="operand">R.gi</e>
        <e type="operand">R.g</e>
        <e type="operand">n.par</e>
        <e type="operator" args="2">/</e>
        <e type="operator" args="2">:</e>
      </input>
        <contract>
          <e type="operand" style="unit">ohm</e>
        </contract>
        <result action="numeric">
          <e type="operand">4.50</e>
        </result>
    </math>
    </region>
    <region left="20" top="4236" width="470" height="53" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- Turn-off path resistance, R.off parallel R.on:</p>
      </content>
    </text>
    </region>
    <region left="510" top="4236" width="1080" height="53" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="3">
      <input>
        <e type="operand">R.eff</e>
        <e type="operand">R.off</e>
        <e type="operand">R.on</e>
        <e type="operator" args="2">*</e>
        <e type="operand">R.off</e>
        <e type="operand">R.on</e>
        <e type="operator" args="2">+</e>
        <e type="operator" args="2">/</e>
        <e type="operator" args="2">:</e>
      </input>
        <contract>
          <e type="operand" style="unit">ohm</e>
        </contract>
        <result action="numeric">
          <e type="operand">1.499</e>
        </result>
    </math>
    </region>
    <region left="20" top="4297" width="470" height="53" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- Turn-off path offset from D.off:</p>
      </content>
    </text>
    </region>
    <region left="510" top="4297" width="1080" height="53" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="3">
      <input>
        <e type="operand">V.eff</e>
        <e type="operand">V.F_off</e>
        <e type="operand">R.on</e>
        <e type="operator" args="2">*</e>
        <e type="operand">R.off</e>
        <e type="operand">R.on</e>
        <e type="operator" args="2">+</e>
        <e type="operator" args="2">/</e>
        <e type="operator" args="2">:</e>
      </input>
        <contract>
          <e type="operand" style="unit">V</e>
        </contract>
        <result action="numeric">
          <e type="operand">0.477</e>
        </result>
    </math>
    </region>
    <region left="20" top="4358" width="470" height="35" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- tau.on = (R.so + R.on + R.gi) C.G:</p>
      </content>
    </text>
    </region>
    <region left="510" top="4358" width="1080" height="35" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="1">
      <input>
        <e type="operand">τ.on</e>
        <e type="operand">R.so</e>
        <e type="operand">R.on</e>
        <e type="operator" args="2">+</e>
        <e type="operand">R.gi</e>
        <e type="operator" args="2">+</e>
        <e type="bracket">(</e>
        <e type="operand">C.G</e>
        <e type="operator" args="2">*</e>
        <e type="operator" args="2">:</e>
      </input>
        <contract>
          <e type="operand" style="unit">ns</e>
        </contract>
        <result action="numeric">
          <e type="operand">149.4</e>
        </result>
    </math>
    </region>
    <region left="20" top="4544" width="470" height="35" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- tau.off = (R.si + R.eff + R.gi) C.G:</p>
      </content>
    </text>
    </region>
    <region left="510" top="4544" width="1080" height="35" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="1">
      <input>
        <e type="operand">τ.off</e>
        <e type="operand">R.si</e>
        <e type="operand">R.eff</e>
        <e type="operator" args="2">+</e>
        <e type="operand">R.gi</e>
        <e type="operator" args="2">+</e>
        <e type="bracket">(</e>
        <e type="operand">C.G</e>
        <e type="operator" args="2">*</e>
        <e type="operator" args="2">:</e>
      </input>
        <contract>
          <e type="operand" style="unit">ns</e>
        </contract>
        <result action="numeric">
          <e type="operand">117.6</e>
        </result>
    </math>
    </region>
    <region left="20" top="4587" width="470" height="76" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- Start-up pulse, T/2 - max(t.D.su, t.DT) (first LOUT pulse):</p>
      </content>
    </text>
    </region>
    <region left="510" top="4587" width="1080" height="76" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="1">
      <input>
        <e type="operand">t.L1</e>
        <e type="operand">1</e>
        <e type="operand">2</e>
        <e type="operand">f.SU</e>
        <e type="operator" args="2">*</e>
        <e type="operator" args="2">/</e>
        <e type="operand">t.D_su</e>
        <e type="operand">t.DT</e>
        <e type="operator" args="2">+</e>
        <e type="operand">t.D_su</e>
        <e type="operand" style="unit">s</e>
        <e type="operator" args="2">/</e>
        <e type="operand">t.DT</e>
        <e type="operand" style="unit">s</e>
        <e type="operator" args="2">/</e>
        <e type="operator" args="2">-</e>
        <e type="function" args="1">abs</e>
        <e type="operand" style="unit">s</e>
        <e type="operator" args="2">*</e>
        <e type="operator" args="2">+</e>
        <e type="operand">2</e>
        <e type="operator" args="2">/</e>
        <e type="operator" args="2">-</e>
        <e type="operator" args="2">:</e>
      </input>
        <contract>
          <e type="operand" style="unit">ns</e>
        </contract>
        <result action="numeric">
          <e type="operand">629.5</e>
        </result>
    </math>
    </region>
    <region left="20" top="4671" width="470" height="76" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- Pulse at f.Max, T/2 - max(t.D, t.DT):</p>
      </content>
