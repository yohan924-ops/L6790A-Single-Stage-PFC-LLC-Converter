        <e type="operator" args="2">:</e>
      </input>
        <result action="numeric">
          <e type="operand">6.205</e>
        </result>
    </math>
    </region>
    <region left="20" top="14378" width="470" height="53" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- OCP1 margin at start-up (&gt;1):</p>
