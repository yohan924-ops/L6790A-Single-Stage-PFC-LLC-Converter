        <e type="operand">I.su</e>
      </input>
        <contract>
          <e type="operand" style="unit">A</e>
        </contract>
        <result action="numeric">
          <e type="operand">5.036</e>
        </result>
    </math>
    </region>
    <region left="20" top="14317" width="470" height="53" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- OCP2 margin at start-up (&gt;1):</p>
      </content>
