      <input>
        <e type="operand">R.off</e>
        <e type="operand">2.2</e>
        <e type="operand" style="unit">ohm</e>
        <e type="operator" args="2">*</e>
        <e type="operator" args="2">:</e>
      </input>
    </math>
    </region>
    <region left="20" top="3952" width="470" height="35" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">[PICK] Gate-source capacitor C.gs (0 = none):</p>
      </content>
    </text>
    </region>
    <region left="510" top="3952" width="1080" height="35" color="#000000" bgColor="#ffff80" fontSize="8" isBreakable="false">
