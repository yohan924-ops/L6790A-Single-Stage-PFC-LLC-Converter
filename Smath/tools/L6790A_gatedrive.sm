        <e type="operand">I.FSM_boot</e>
        <e type="operand">30</e>
        <e type="operand" style="unit">A</e>
        <e type="operator" args="2">*</e>
        <e type="operator" args="2">:</e>
      </input>
    </math>
    </region>
    <region left="20" top="3553" width="470" height="35" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">[DS] D.off forward voltage (0 = no diode, GOFF pin):</p>
      </content>
    </text>
    </region>
    <region left="510" top="3553" width="1080" height="35" color="#000000" bgColor="#ffff80" fontSize="8" isBreakable="false">
