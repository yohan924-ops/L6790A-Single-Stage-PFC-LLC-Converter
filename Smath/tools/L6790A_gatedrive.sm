        <e type="operand">0</e>
        <e type="operand" style="unit">nF</e>
        <e type="operator" args="2">*</e>
        <e type="operator" args="2">:</e>
      </input>
    </math>
    </region>
    <region left="20" top="3995" width="470" height="35" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">[PICK] Bootstrap capacitor C.boot:</p>
