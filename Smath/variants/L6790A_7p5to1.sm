        <e type="operand">k.RN</e>
        <e type="operand">R.Nmax</e>
        <e type="operand">R.Nact</e>
        <e type="operator" args="2">/</e>
        <e type="operator" args="2">:</e>
      </input>
        <result action="numeric">
          <e type="operand">1.720</e>
        </result>
    </math>
    </region>
    <region left="20" top="27613" width="470" height="102" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- Dissipation in the output bank:</p>
      </content>
    </text>
    </region>
    <region left="510" top="27613" width="1080" height="102" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="3">
      <input>
        <e type="operand">P.Cout</e>
        <e type="operand">I.Cout_rms</e>
        <e type="operand">2</e>
        <e type="operator" args="2">^</e>
        <e type="operand">2</e>
        <e type="operand">π</e>
        <e type="operator" args="2">*</e>
        <e type="operand">f.sw.a</e>
        <e type="operator" args="2">*</e>
        <e type="operand">C.ceramic</e>
        <e type="operator" args="2">*</e>
        <e type="operand">DF</e>
        <e type="operand">100</e>
        <e type="operator" args="2">/</e>
        <e type="operator" args="2">/</e>
        <e type="operand">1</e>
        <e type="operand">ESR.out</e>
        <e type="operator" args="2">/</e>
        <e type="operator" args="2">+</e>
        <e type="operator" args="2">/</e>
        <e type="operator" args="2">:</e>
      </input>
        <contract>
          <e type="operand" style="unit">W</e>
        </contract>
        <result action="numeric">
          <e type="operand">0.162</e>
        </result>
    </math>
    </region>
    <region left="20" top="27841" width="1560" height="27" color="#0f2a44" fontSize="12" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: bold; font-style: normal; font-size: 12px;">12. Transformer Construction</p>
      </content>
    </text>
    </region>
    <region left="20" top="27876" width="470" height="35" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- Number of transformers in the series string:</p>
      </content>
    </text>
    </region>
    <region left="510" top="27876" width="1080" height="35" color="#000000" bgColor="#ffff80" fontSize="8" isBreakable="false">
    <math>
      <input>
        <e type="operand">N.x</e>
        <e type="operand">3</e>
        <e type="operator" args="2">:</e>
      </input>
    </math>
    </region>
    <region left="20" top="27919" width="470" height="35" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- Primary turns per transformer:</p>
      </content>
    </text>
    </region>
    <region left="510" top="27919" width="1080" height="35" color="#000000" bgColor="#ffff80" fontSize="8" isBreakable="false">
    <math>
      <input>
        <e type="operand">N.p</e>
        <e type="operand">5</e>
        <e type="operator" args="2">:</e>
      </input>
    </math>
    </region>
    <region left="20" top="27962" width="470" height="35" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- Secondary half-winding turns:</p>
      </content>
    </text>
    </region>
    <region left="510" top="27962" width="1080" height="35" color="#000000" bgColor="#ffff80" fontSize="8" isBreakable="false">
    <math>
      <input>
        <e type="operand">N.s</e>
        <e type="operand">2</e>
        <e type="operator" args="2">:</e>
      </input>
    </math>
    </region>
    <region left="20" top="28005" width="470" height="53" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- Wound turns ratio:</p>
      </content>
    </text>
    </region>
    <region left="510" top="28005" width="1080" height="53" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="4">
      <input>
        <e type="operand">n.T_act</e>
        <e type="operand">N.x</e>
        <e type="operand">N.p</e>
        <e type="operator" args="2">*</e>
        <e type="operand">N.s</e>
        <e type="operator" args="2">/</e>
        <e type="operator" args="2">:</e>
      </input>
        <result action="numeric">
          <e type="operand">7.5000</e>
        </result>
    </math>
    </region>
    <region left="20" top="28066" width="470" height="62" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- Resulting equivalent-model turns ratio:</p>
      </content>
    </text>
    </region>
    <region left="510" top="28066" width="1080" height="62" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="4">
      <input>
        <e type="operand">n.act</e>
        <e type="operand">n.T_act</e>
        <e type="operand">1</e>
        <e type="operand">λ.act</e>
        <e type="operator" args="2">+</e>
        <e type="function" args="1">sqrt</e>
        <e type="operator" args="2">/</e>
        <e type="operator" args="2">:</e>
      </input>
        <result action="numeric">
          <e type="operand">6.0241</e>
        </result>
    </math>
    </region>
    <region left="20" top="28136" width="470" height="35" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- Resulting reflected voltage:</p>
      </content>
    </text>
    </region>
    <region left="510" top="28136" width="1080" height="35" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="2">
      <input>
        <e type="operand">V.refl_act</e>
        <e type="operand">n.act</e>
        <e type="operand">V.o_eff</e>
        <e type="operator" args="2">*</e>
        <e type="operator" args="2">:</e>
      </input>
        <contract>
          <e type="operand" style="unit">V</e>
        </contract>
        <result action="numeric">
          <e type="operand">150.60</e>
        </result>
    </math>
    </region>
    <region left="20" top="28179" width="1560" height="23" color="#444444" fontSize="9" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 9px;">compare with V.refl of section 5 and keep the deviation within about 1 %.</p>
      </content>
    </text>
    </region>
    <region left="20" top="28210" width="470" height="35" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- Core effective area [mm^2]:</p>
      </content>
    </text>
    </region>
    <region left="510" top="28210" width="1080" height="35" color="#000000" bgColor="#ffff80" fontSize="8" isBreakable="false">
    <math>
      <input>
        <e type="operand">A.e_mm</e>
        <e type="operand">113.1</e>
        <e type="operator" args="2">:</e>
      </input>
    </math>
    </region>
    <region left="20" top="28253" width="470" height="35" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- Core effective area:</p>
      </content>
    </text>
    </region>
    <region left="510" top="28253" width="1080" height="35" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="8">
      <input>
        <e type="operand">A.e</e>
        <e type="operand">A.e_mm</e>
        <e type="operand" style="unit">mm</e>
        <e type="operator" args="2">*</e>
        <e type="operand" style="unit">mm</e>
        <e type="operator" args="2">*</e>
        <e type="operator" args="2">:</e>
      </input>
        <result action="numeric">
          <e type="operand">0.00011310</e>
        </result>
    </math>
    </region>
    <region left="20" top="28296" width="470" height="53" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- Open-circuit inductance per transformer:</p>
      </content>
    </text>
    </region>
    <region left="510" top="28296" width="1080" height="53" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="3">
      <input>
        <e type="operand">L.open_x</e>
        <e type="operand">L.open</e>
        <e type="operand">N.x</e>
        <e type="operator" args="2">/</e>
        <e type="operator" args="2">:</e>
      </input>
        <contract>
          <e type="operand" style="unit">μH</e>
        </contract>
        <result action="numeric">
          <e type="operand">10.333</e>
        </result>
    </math>
    </region>
    <region left="20" top="28357" width="470" height="53" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- Physical magnetizing inductance per transformer:</p>
      </content>
    </text>
    </region>
    <region left="510" top="28357" width="1080" height="53" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="3">
      <input>
        <e type="operand">L.mu_x</e>
        <e type="operand">L.mu</e>
        <e type="operand">N.x</e>
        <e type="operator" args="2">/</e>
        <e type="operator" args="2">:</e>
      </input>
        <contract>
          <e type="operand" style="unit">μH</e>
        </contract>
        <result action="numeric">
          <e type="operand">8.300</e>
        </result>
    </math>
    </region>
    <region left="20" top="28418" width="1560" height="23" color="#444444" fontSize="9" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 9px;">L.mu, not L.open: only this part of the open-circuit flux linkage goes round the core. The rest is primary leakage.</p>
      </content>
    </text>
    </region>
    <region left="20" top="28449" width="470" height="65" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- Inductance factor required:</p>
      </content>
    </text>
    </region>
    <region left="510" top="28449" width="1080" height="65" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="2">
      <input>
        <e type="operand">A.L</e>
        <e type="operand">L.open_x</e>
        <e type="operand">N.p</e>
        <e type="operand">2</e>
        <e type="operator" args="2">^</e>
        <e type="operator" args="2">/</e>
        <e type="operator" args="2">:</e>
      </input>
        <contract>
          <e type="operand" style="unit">nH</e>
        </contract>
        <result action="numeric">
          <e type="operand">413.33</e>
        </result>
    </math>
    </region>
    <region left="20" top="28522" width="470" height="90" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- Peak flux density in each core:</p>
      </content>
    </text>
    </region>
    <region left="510" top="28522" width="1080" height="90" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="1">
      <input>
        <e type="operand">B.pk</e>
        <e type="operand">n.T_act</e>
        <e type="operand">V.o_eff</e>
        <e type="operator" args="2">*</e>
        <e type="operand">N.x</e>
        <e type="operator" args="2">/</e>
        <e type="operand">2</e>
        <e type="operand">f.r</e>
        <e type="operator" args="2">*</e>
        <e type="operator" args="2">/</e>
        <e type="operand">2</e>
        <e type="operand">N.p</e>
        <e type="operator" args="2">*</e>
        <e type="operand">A.e</e>
        <e type="operator" args="2">*</e>
        <e type="operator" args="2">/</e>
        <e type="operator" args="2">:</e>
      </input>
        <contract>
          <e type="operand" style="unit">mT</e>
        </contract>
        <result action="numeric">
          <e type="operand">182.1</e>
        </result>
    </math>
    </region>
    <region left="20" top="28620" width="470" height="35" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">[PICK] Peak flux density allowed:</p>
      </content>
    </text>
    </region>
    <region left="510" top="28620" width="1080" height="35" color="#000000" bgColor="#ffff80" fontSize="8" isBreakable="false">
    <math>
      <input>
        <e type="operand">B.max</e>
        <e type="operand">0.2</e>
        <e type="operand" style="unit">T</e>
        <e type="operator" args="2">*</e>
        <e type="operator" args="2">:</e>
      </input>
    </math>
    </region>
    <region left="20" top="28663" width="1560" height="23" color="#444444" fontSize="9" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 9px;">about half of saturation at Tc 100 C.</p>
      </content>
    </text>
    </region>
    <region left="20" top="28694" width="470" height="90" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- Core area this requires:</p>
      </content>
    </text>
    </region>
    <region left="510" top="28694" width="1080" height="90" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="8">
      <input>
        <e type="operand">A.e_req</e>
        <e type="operand">n.T_act</e>
        <e type="operand">V.o_eff</e>
        <e type="operator" args="2">*</e>
        <e type="operand">N.x</e>
        <e type="operator" args="2">/</e>
        <e type="operand">2</e>
        <e type="operand">f.r</e>
        <e type="operator" args="2">*</e>
        <e type="operator" args="2">/</e>
        <e type="operand">2</e>
        <e type="operand">N.p</e>
        <e type="operator" args="2">*</e>
        <e type="operand">B.max</e>
        <e type="operator" args="2">*</e>
        <e type="operator" args="2">/</e>
        <e type="operator" args="2">:</e>
      </input>
        <result action="numeric">
          <e type="operand">0.00010297</e>
        </result>
    </math>
    </region>
    <region left="20" top="28961" width="470" height="53" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- Core area required [mm^2]:</p>
      </content>
    </text>
    </region>
    <region left="510" top="28961" width="1080" height="53" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="1">
      <input>
        <e type="operand">A.e_req_mm</e>
        <e type="operand">A.e_req</e>
        <e type="operand" style="unit">mm</e>
        <e type="operand" style="unit">mm</e>
        <e type="operator" args="2">*</e>
        <e type="operator" args="2">/</e>
        <e type="operator" args="2">:</e>
      </input>
        <result action="numeric">
          <e type="operand">103.0</e>
        </result>
    </math>
    </region>
    <region left="20" top="29022" width="470" height="53" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- Core area margin (&gt;1):</p>
      </content>
    </text>
    </region>
    <region left="510" top="29022" width="1080" height="53" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="3">
      <input>
        <e type="operand">k.Ae</e>
        <e type="operand">A.e</e>
        <e type="operand">A.e_req</e>
        <e type="operator" args="2">/</e>
        <e type="operator" args="2">:</e>
      </input>
        <result action="numeric">
          <e type="operand">1.098</e>
        </result>
    </math>
    </region>
    <region left="20" top="29083" width="1560" height="23" color="#444444" fontSize="9" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 9px;">below 1 means the core is too small for the flux target.</p>
      </content>
    </text>
    </region>
    <region left="20" top="29114" width="470" height="53" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- Flux-equivalent DC test current:</p>
      </content>
    </text>
    </region>
    <region left="510" top="29114" width="1080" height="53" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="2">
      <input>
        <e type="operand">I.sat_eq</e>
        <e type="operand">B.pk</e>
        <e type="operand">N.p</e>
        <e type="operator" args="2">*</e>
        <e type="operand">A.e</e>
        <e type="operator" args="2">*</e>
        <e type="operand">L.mu_x</e>
        <e type="operator" args="2">/</e>
        <e type="operator" args="2">:</e>
      </input>
        <contract>
          <e type="operand" style="unit">A</e>
        </contract>
        <result action="numeric">
          <e type="operand">12.41</e>
        </result>
    </math>
    </region>
    <region left="20" top="29175" width="1560" height="51" color="#444444" fontSize="9" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 9px;">the DC current that reproduces B.pk in the OPEN-circuit test. Divide by L.mu_x, not by L.open_x: the leakage part of the open flux linkage does not thread the centre leg, so using L.open puts B.pk at a lower current than it really takes and UNDER-specifies</p>
        <p style="font-weight: normal; font-style: normal; font-size: 9px;">the test. The answer must come out equal to I.Lm_pk, because with the secondary open the whole primary current IS magnetizing current - check_trans_spec tests that.</p>
      </content>
    </text>
    </region>
    <region left="20" top="29234" width="470" height="53" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- Secondary rms current per transformer:</p>
      </content>
    </text>
    </region>
    <region left="510" top="29234" width="1080" height="53" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="2">
      <input>
        <e type="operand">I.sec_x</e>
        <e type="operand">I.diode_lc</e>
        <e type="operand">N.x</e>
        <e type="operator" args="2">/</e>
        <e type="operator" args="2">:</e>
      </input>
        <contract>
          <e type="operand" style="unit">A</e>
        </contract>
        <result action="numeric">
          <e type="operand">9.45</e>
        </result>
    </math>
    </region>
    <region left="20" top="29295" width="470" height="35" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- Primary rms current (same in all - series):</p>
      </content>
    </text>
    </region>
    <region left="510" top="29295" width="1080" height="35" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="3">
      <input>
        <e type="operand">I.pri_x</e>
        <e type="operand">I.pri_lc</e>
        <e type="operator" args="2">:</e>
      </input>
        <contract>
          <e type="operand" style="unit">A</e>
        </contract>
        <result action="numeric">
          <e type="operand">10.915</e>
        </result>
    </math>
    </region>
    <region left="20" top="29354" width="1560" height="27" color="#0f2a44" fontSize="12" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: bold; font-style: normal; font-size: 12px;">13. Semiconductor Selection   [111] - [121]</p>
      </content>
    </text>
    </region>
    <region left="20" top="29389" width="470" height="35" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">[PICK] Number of primary switches:</p>
