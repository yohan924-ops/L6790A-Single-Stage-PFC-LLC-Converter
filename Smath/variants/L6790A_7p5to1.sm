    <math decimalPlaces="3">
      <input>
        <e type="operand">k.VCC</e>
        <e type="operand">V.CC_opmax</e>
        <e type="operand">V.CC_reg_max</e>
        <e type="operator" args="2">/</e>
        <e type="operator" args="2">:</e>
      </input>
        <result action="numeric">
          <e type="operand">1.742</e>
        </result>
    </math>
    </region>
    <region left="20" top="40018" width="1560" height="23" color="#444444" fontSize="9" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 9px;">The load on this rail is the IC and the gate drivers. The driver share is the gate charge of every switch position, once per period.</p>
      </content>
    </text>
    </region>
    <region left="20" top="40049" width="470" height="47" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">[CANDIDATE] Primary MOSFET gate charge, typ.:</p>
      </content>
    </text>
    </region>
    <region left="510" top="40049" width="1080" height="47" color="#000000" bgColor="#ffff80" fontSize="8" isBreakable="false">
    <math>
      <input>
        <e type="operand">Q.g</e>
        <e type="operand">78.6</e>
        <e type="operand">10</e>
        <e type="operand">9</e>
        <e type="operator" args="1">-</e>
        <e type="operator" args="2">^</e>
        <e type="operator" args="2">*</e>
        <e type="operand" style="unit">A</e>
        <e type="operator" args="2">*</e>
        <e type="operand" style="unit">s</e>
        <e type="operator" args="2">*</e>
        <e type="operator" args="2">:</e>
      </input>
    </math>
    </region>
    <region left="20" top="40104" width="1560" height="23" color="#444444" fontSize="9" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 9px;">STO60N045DM9, the candidate primary MOSFET, as listed by DiscoverEE; confirm it on the ST datasheet. 78.6 nC.</p>
      </content>
    </text>
    </region>
    <region left="20" top="40135" width="470" height="35" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- Switch positions driven in full bridge:</p>
      </content>
    </text>
    </region>
    <region left="510" top="40135" width="1080" height="35" color="#000000" bgColor="#ffff80" fontSize="8" isBreakable="false">
    <math>
      <input>
        <e type="operand">N.sw</e>
        <e type="operand">4</e>
        <e type="operator" args="2">:</e>
      </input>
    </math>
    </region>
    <region left="20" top="40178" width="470" height="35" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- Supply current in run, bound at f.Max:</p>
      </content>
    </text>
    </region>
    <region left="510" top="40178" width="1080" height="35" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="1">
      <input>
        <e type="operand">I.VCC</e>
        <e type="operand">I.CC</e>
        <e type="operand">N.sw</e>
        <e type="operand">n.par</e>
        <e type="operator" args="2">*</e>
        <e type="operand">Q.g</e>
        <e type="operator" args="2">*</e>
        <e type="operand">f.Max</e>
        <e type="operator" args="2">*</e>
        <e type="operator" args="2">+</e>
        <e type="operator" args="2">:</e>
      </input>
        <contract>
          <e type="operand" style="unit">mA</e>
        </contract>
        <result action="numeric">
          <e type="operand">103.5</e>
        </result>
    </math>
    </region>
    <region left="20" top="40221" width="1560" height="23" color="#444444" fontSize="9" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 9px;">Q.g holds at the datasheet test condition; a gate driven harder takes more charge. f.Max is the highest run frequency.</p>
      </content>
    </text>
    </region>
    <region left="20" top="40252" width="470" height="35" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">[PICK] Pass transistor current gain at I.VCC, min.:</p>
      </content>
    </text>
    </region>
    <region left="510" top="40252" width="1080" height="35" color="#000000" bgColor="#ffff80" fontSize="8" isBreakable="false">
    <math>
      <input>
        <e type="operand">β.min</e>
        <e type="operand">50</e>
        <e type="operator" args="2">:</e>
      </input>
    </math>
    </region>
    <region left="20" top="40295" width="470" height="35" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">[PICK] Minimum Zener bias current:</p>
      </content>
    </text>
    </region>
    <region left="510" top="40295" width="1080" height="35" color="#000000" bgColor="#ffff80" fontSize="8" isBreakable="false">
    <math>
      <input>
        <e type="operand">I.DZ_min</e>
        <e type="operand">1</e>
        <e type="operand" style="unit">mA</e>
        <e type="operator" args="2">*</e>
        <e type="operator" args="2">:</e>
      </input>
    </math>
    </region>
    <region left="20" top="40338" width="470" height="71" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- Largest R.BZ that still regulates at the end of hold-up:</p>
      </content>
    </text>
    </region>
    <region left="510" top="40338" width="1080" height="71" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="0">
      <input>
        <e type="operand">R.BZ_max</e>
        <e type="operand">V.Caux_hold</e>
        <e type="operand">V.DZ_max</e>
        <e type="operator" args="2">-</e>
        <e type="operand">I.VCC</e>
        <e type="operand">β.min</e>
        <e type="operator" args="2">/</e>
        <e type="operand">I.DZ_min</e>
        <e type="operator" args="2">+</e>
        <e type="operator" args="2">/</e>
        <e type="operator" args="2">:</e>
      </input>
        <contract>
          <e type="operand" style="unit">ohm</e>
        </contract>
        <result action="numeric">
          <e type="operand">831</e>
        </result>
    </math>
    </region>
    <region left="20" top="40417" width="470" height="35" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">[PICK] SELECTED Zener feed resistor R.BZ:</p>
      </content>
    </text>
    </region>
    <region left="510" top="40417" width="1080" height="35" color="#000000" bgColor="#ffff80" fontSize="8" isBreakable="false">
    <math>
      <input>
        <e type="operand">R.BZ_sel</e>
        <e type="operand">820</e>
        <e type="operand" style="unit">ohm</e>
        <e type="operator" args="2">*</e>
        <e type="operator" args="2">:</e>
      </input>
    </math>
    </region>
    <region left="20" top="40460" width="470" height="53" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- R.BZ margin (&gt;1):</p>
      </content>
    </text>
    </region>
    <region left="510" top="40460" width="1080" height="53" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="3">
      <input>
        <e type="operand">k.RBZ</e>
        <e type="operand">R.BZ_max</e>
        <e type="operand">R.BZ_sel</e>
        <e type="operator" args="2">/</e>
        <e type="operator" args="2">:</e>
      </input>
        <result action="numeric">
          <e type="operand">1.013</e>
        </result>
    </math>
    </region>
    <region left="20" top="40684" width="470" height="53" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- Zener dissipation, no load, C.aux at OVP1 (rating to buy):</p>
      </content>
    </text>
    </region>
    <region left="510" top="40684" width="1080" height="53" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="0">
      <input>
        <e type="operand">P.DZ</e>
        <e type="operand">V.DZ_max</e>
        <e type="operand">V.Caux_OVP1</e>
        <e type="operand">V.DZ_min</e>
        <e type="operator" args="2">-</e>
        <e type="bracket">(</e>
        <e type="operator" args="2">*</e>
        <e type="operand">R.BZ_sel</e>
        <e type="operator" args="2">/</e>
        <e type="operator" args="2">:</e>
      </input>
        <contract>
          <e type="operand" style="unit">mW</e>
        </contract>
        <result action="numeric">
          <e type="operand">269</e>
        </result>
    </math>
    </region>
    <region left="20" top="40745" width="470" height="35" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- Pass transistor dissipation at OVP1 and I.VCC (rating to buy):</p>
      </content>
    </text>
    </region>
    <region left="510" top="40745" width="1080" height="35" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="2">
      <input>
        <e type="operand">P.Qpass</e>
        <e type="operand">V.Caux_OVP1</e>
        <e type="operand">V.DZ_min</e>
        <e type="operand">V.F_j</e>
        <e type="operator" args="2">-</e>
        <e type="bracket">(</e>
        <e type="operator" args="2">-</e>
        <e type="bracket">(</e>
        <e type="operand">I.VCC</e>
        <e type="operator" args="2">*</e>
        <e type="operator" args="2">:</e>
      </input>
        <contract>
          <e type="operand" style="unit">W</e>
        </contract>
        <result action="numeric">
          <e type="operand">1.52</e>
        </result>
    </math>
    </region>
    <region left="20" top="40788" width="1560" height="23" color="#444444" fontSize="9" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 9px;">at the nominal output it is (V.Caux-V.CC_reg-V.F_j)*I.VCC. With n.aux = 1.5 the voltage across it would grow by V.out/2.</p>
      </content>
    </text>
    </region>
    <region left="20" top="40819" width="1560" height="51" color="#444444" fontSize="9" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 9px;">START-UP. The HVSU charges C.VCC to V.CC_on and switching begins. Until the output is high enough for the winding to carry VCC, C.VCC supplies the drivers - the HVSU only returns its own few mA below V.CC_HVSUon. The worst case is the full bridge (low line,</p>
        <p style="font-weight: normal; font-style: normal; font-size: 9px;">13 mA) at the start-up frequency.</p>
      </content>
    </text>
    </region>
    <region left="20" top="40878" width="470" height="35" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- Supply current during start-up (full bridge at f.SU):</p>
      </content>
    </text>
    </region>
    <region left="510" top="40878" width="1080" height="35" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="1">
      <input>
        <e type="operand">I.VCC_SU</e>
        <e type="operand">I.CC</e>
        <e type="operand">N.sw</e>
        <e type="operand">n.par</e>
        <e type="operator" args="2">*</e>
        <e type="operand">Q.g</e>
        <e type="operator" args="2">*</e>
        <e type="operand">f.SU</e>
        <e type="operator" args="2">*</e>
        <e type="operator" args="2">+</e>
        <e type="operator" args="2">:</e>
      </input>
        <contract>
          <e type="operand" style="unit">mA</e>
        </contract>
        <result action="numeric">
          <e type="operand">161.3</e>
        </result>
    </math>
    </region>
    <region left="20" top="40921" width="470" height="71" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- Output voltage at which the winding holds VCC at V.CC_off:</p>
      </content>
    </text>
    </region>
    <region left="510" top="40921" width="1080" height="71" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="2">
      <input>
        <e type="operand">V.out_UV</e>
        <e type="operand">V.CC_off</e>
        <e type="operand">3</e>
        <e type="operand">V.F_j</e>
        <e type="operator" args="2">*</e>
        <e type="operator" args="2">+</e>
        <e type="operand">I.VCC_SU</e>
        <e type="operand">β.min</e>
        <e type="operator" args="2">/</e>
        <e type="operand">R.BZ_sel</e>
        <e type="operator" args="2">*</e>
        <e type="operator" args="2">+</e>
        <e type="operand">n.aux</e>
        <e type="operator" args="2">/</e>
        <e type="operator" args="2">:</e>
      </input>
        <contract>
          <e type="operand" style="unit">V</e>
        </contract>
        <result action="numeric">
          <e type="operand">12.75</e>
        </result>
    </math>
    </region>
    <region left="20" top="41000" width="470" height="53" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- Time to get there, rated current into C.out and NO load:</p>
      </content>
    </text>
    </region>
    <region left="510" top="41000" width="1080" height="53" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="1">
      <input>
        <e type="operand">t.hand</e>
        <e type="operand">C.out</e>
        <e type="operand">V.out_UV</e>
        <e type="operator" args="2">*</e>
        <e type="operand">I.out</e>
        <e type="operator" args="2">/</e>
        <e type="operator" args="2">:</e>
      </input>
        <contract>
          <e type="operand" style="unit">ms</e>
        </contract>
        <result action="numeric">
          <e type="operand">36.4</e>
        </result>
    </math>
    </region>
    <region left="20" top="41061" width="1560" height="23" color="#444444" fontSize="9" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 9px;">[ASSUMED] the load is held off until the rail is up, as a TV sequences its panel. Any load during start-up stretches this.</p>
      </content>
    </text>
    </region>
    <region left="20" top="41092" width="470" height="53" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- hand-over inside the HVSU window (&gt;1):</p>
      </content>
    </text>
    </region>
    <region left="510" top="41092" width="1080" height="53" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="3">
      <input>
        <e type="operand">k.thand</e>
        <e type="operand">t.HVSU</e>
        <e type="operand">t.hand</e>
        <e type="operator" args="2">/</e>
        <e type="operator" args="2">:</e>
      </input>
        <result action="numeric">
          <e type="operand">3.293</e>
        </result>
    </math>
    </region>
    <region left="20" top="41153" width="470" height="53" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- C.VCC that bridges the hand-over:</p>
      </content>
    </text>
    </region>
    <region left="510" top="41153" width="1080" height="53" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="0">
      <input>
        <e type="operand">C.VCC_req</e>
        <e type="operand">I.VCC_SU</e>
        <e type="operand">I.HVSU_lo</e>
        <e type="operator" args="2">-</e>
        <e type="bracket">(</e>
        <e type="operand">t.hand</e>
        <e type="operator" args="2">*</e>
        <e type="operand">V.CC_on</e>
        <e type="operand">V.CC_off</e>
        <e type="operator" args="2">-</e>
        <e type="operator" args="2">/</e>
        <e type="operator" args="2">:</e>
      </input>
        <contract>
          <e type="operand" style="unit">μF</e>
        </contract>
        <result action="numeric">
          <e type="operand">601</e>
        </result>
    </math>
    </region>
    <region left="20" top="41214" width="470" height="35" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">[PICK] SELECTED C.VCC:</p>
      </content>
    </text>
    </region>
    <region left="510" top="41214" width="1080" height="35" color="#000000" bgColor="#ffff80" fontSize="8" isBreakable="false">
    <math>
      <input>
        <e type="operand">C.VCC_sel</e>
        <e type="operand">680</e>
        <e type="operand" style="unit">μF</e>
        <e type="operator" args="2">*</e>
        <e type="operator" args="2">:</e>
      </input>
    </math>
    </region>
    <region left="20" top="41257" width="470" height="53" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- C.VCC margin (&gt;1):</p>
      </content>
    </text>
    </region>
    <region left="510" top="41257" width="1080" height="53" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="3">
      <input>
        <e type="operand">k.CVCC</e>
        <e type="operand">C.VCC_sel</e>
        <e type="operand">C.VCC_req</e>
        <e type="operator" args="2">/</e>
        <e type="operator" args="2">:</e>
      </input>
        <result action="numeric">
          <e type="operand">1.132</e>
        </result>
    </math>
    </region>
    <region left="20" top="41318" width="470" height="53" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- Delay before the first switching, 230 Vac:</p>
      </content>
    </text>
    </region>
    <region left="510" top="41318" width="1080" height="53" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="2">
      <input>
        <e type="operand">t.VCCchg</e>
        <e type="operand">C.VCC_sel</e>
        <e type="operand">V.CC_on</e>
        <e type="operator" args="2">*</e>
        <e type="operand">I.HVSU_hi</e>
        <e type="operator" args="2">/</e>
        <e type="operator" args="2">:</e>
      </input>
        <contract>
          <e type="operand" style="unit">s</e>
        </contract>
        <result action="numeric">
          <e type="operand">1.28</e>
        </result>
    </math>
    </region>
    <region left="20" top="41379" width="1560" height="23" color="#444444" fontSize="9" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 9px;">the price of C.VCC: the HVSU fills it at 9 mA from the line. Check the HVSU temperature on the prototype (DS: HVSU over-temperature protection).</p>
      </content>
    </text>
    </region>
    <region left="20" top="41426" width="1560" height="27" color="#0f2a44" fontSize="12" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: bold; font-style: normal; font-size: 12px;">14b. Datasheet Operating Limits - every ratio below must be greater than 1</p>
      </content>
    </text>
    </region>
    <region left="20" top="41461" width="1560" height="23" color="#444444" fontSize="9" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 9px;">DS Table 2 (recommended operating range) and DS section 5.3.2. These are hard silicon limits, not design preferences.</p>
      </content>
    </text>
    </region>
    <region left="20" top="41492" width="470" height="53" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- R.T above the 5 k minimum:</p>
      </content>
    </text>
    </region>
    <region left="510" top="41492" width="1080" height="53" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="3">
      <input>
        <e type="operand">k.RT_lo</e>
        <e type="operand">R.T</e>
        <e type="operand">5000</e>
        <e type="operand" style="unit">ohm</e>
        <e type="operator" args="2">*</e>
        <e type="operator" args="2">/</e>
        <e type="operator" args="2">:</e>
      </input>
        <result action="numeric">
          <e type="operand">2.200</e>
        </result>
    </math>
    </region>
    <region left="20" top="41553" width="470" height="53" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- R.T below the 30 k maximum:</p>
      </content>
    </text>
    </region>
    <region left="510" top="41553" width="1080" height="53" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="3">
      <input>
        <e type="operand">k.RT_hi</e>
