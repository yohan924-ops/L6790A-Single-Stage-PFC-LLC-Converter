        <e type="operator" args="2">/</e>
        <e type="operator" args="2">:</e>
      </input>
        <result action="numeric">
          <e type="operand">1.071</e>
        </result>
    </math>
    </region>
    <region left="20" top="39926" width="1560" height="23" color="#444444" fontSize="9" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 9px;">below 12 V the HVSU would switch back on and burn line power.</p>
      </content>
    </text>
    </region>
    <region left="20" top="39957" width="470" height="53" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- highest VCC under the 25 V operating limit (&gt;1):</p>
      </content>
    </text>
    </region>
