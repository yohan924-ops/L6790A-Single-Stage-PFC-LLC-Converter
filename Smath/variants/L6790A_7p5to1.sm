        <e type="operand">C.r</e>
        <e type="operator" args="2">/</e>
        <e type="function" args="1">sqrt</e>
        <e type="operator" args="2">:</e>
      </input>
        <contract>
          <e type="operand" style="unit">ohm</e>
        </contract>
        <result action="numeric">
          <e type="operand">17.607</e>
        </result>
    </math>
    </region>
    <region left="20" top="6941" width="470" height="62" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- Series resonant frequency:</p>
      </content>
    </text>
    </region>
    <region left="510" top="6941" width="1080" height="62" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="2">
      <input>
        <e type="operand">f.r</e>
        <e type="operand">1</e>
