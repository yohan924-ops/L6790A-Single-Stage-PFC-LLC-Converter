    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">[BUILD] gain plot to   f.n =</p>
      </content>
    </text>
    </region>
    <region left="510" top="7637" width="1080" height="35" color="#000000" bgColor="#ffff80" fontSize="8" isBreakable="false">
