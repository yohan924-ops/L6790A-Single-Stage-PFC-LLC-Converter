        <e type="operand">λ.act</e>
        <e type="operator" args="2">+</e>
        <e type="operator" args="2">/</e>
        <e type="function" args="1">sqrt</e>
        <e type="operator" args="2">:</e>
      </input>
        <result action="numeric">
          <e type="operand">0.5957</e>
        </result>
    </math>
    </region>
    <region left="20" top="7083" width="470" height="35" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- Lower resonant frequency:</p>
      </content>
    </text>
    </region>
    <region left="510" top="7083" width="1080" height="35" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="2">
      <input>
        <e type="operand">f.o</e>
        <e type="operand">f.r</e>
        <e type="operand">f.n0</e>
        <e type="operator" args="2">*</e>
        <e type="operator" args="2">:</e>
      </input>
        <contract>
          <e type="operand" style="unit">kHz</e>
        </contract>
        <result action="numeric">
          <e type="operand">90.39</e>
        </result>
    </math>
    </region>
    <region left="20" top="7126" width="470" height="53" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- Actual quality factor at the line peak:</p>
      </content>
    </text>
    </region>
    <region left="510" top="7126" width="1080" height="53" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="4">
      <input>
        <e type="operand">Q.pk</e>
        <e type="operand">Z.0s</e>
        <e type="operand">R.ac</e>
        <e type="operator" args="2">/</e>
        <e type="operator" args="2">:</e>
      </input>
        <result action="numeric">
          <e type="operand">0.7655</e>
        </result>
    </math>
    </region>
    <region left="20" top="7187" width="470" height="44" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- Physical magnetizing inductance:</p>
      </content>
    </text>
    </region>
    <region left="510" top="7187" width="1080" height="44" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="2">
      <input>
        <e type="operand">L.mu</e>
        <e type="operand">L.m</e>
        <e type="operand">L.m</e>
        <e type="operand">L.r</e>
        <e type="operator" args="2">+</e>
        <e type="bracket">(</e>
        <e type="operator" args="2">*</e>
        <e type="function" args="1">sqrt</e>
        <e type="operator" args="2">:</e>
      </input>
        <contract>
          <e type="operand" style="unit">μH</e>
        </contract>
        <result action="numeric">
          <e type="operand">24.90</e>
        </result>
    </math>
    </region>
    <region left="20" top="7239" width="470" height="35" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- Primary leakage:</p>
      </content>
    </text>
    </region>
    <region left="510" top="7239" width="1080" height="35" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="2">
      <input>
        <e type="operand">L.L1</e>
        <e type="operand">L.m</e>
        <e type="operand">L.r</e>
        <e type="operator" args="2">+</e>
        <e type="operand">L.mu</e>
        <e type="operator" args="2">-</e>
        <e type="operator" args="2">:</e>
      </input>
        <contract>
          <e type="operand" style="unit">μH</e>
        </contract>
        <result action="numeric">
          <e type="operand">6.10</e>
        </result>
    </math>
    </region>
    <region left="20" top="7282" width="470" height="65" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- Secondary leakage:</p>
      </content>
    </text>
    </region>
    <region left="510" top="7282" width="1080" height="65" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="1">
      <input>
        <e type="operand">L.L2</e>
        <e type="operand">L.L1</e>
        <e type="operand">n.T</e>
        <e type="operand">2</e>
