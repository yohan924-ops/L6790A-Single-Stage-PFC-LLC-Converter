    </region>
    <region left="20" top="39822" width="470" height="35" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- Regulated VCC, high end:</p>
      </content>
    </text>
    </region>
    <region left="510" top="39822" width="1080" height="35" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="2">
      <input>
        <e type="operand">V.CC_reg_max</e>
        <e type="operand">V.DZ_max</e>
        <e type="operand">2</e>
        <e type="operand">V.F_j</e>
        <e type="operator" args="2">*</e>
        <e type="operator" args="2">-</e>
        <e type="operator" args="2">:</e>
      </input>
        <contract>
          <e type="operand" style="unit">V</e>
        </contract>
        <result action="numeric">
          <e type="operand">14.35</e>
        </result>
    </math>
    </region>
    <region left="20" top="39865" width="470" height="53" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- lowest VCC above the HVSU threshold (&gt;1):</p>
      </content>
    </text>
    </region>
    <region left="510" top="39865" width="1080" height="53" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="3">
      <input>
        <e type="operand">k.VCClo</e>
        <e type="operand">V.CC_reg_min</e>
