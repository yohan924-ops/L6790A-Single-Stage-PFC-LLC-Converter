        </contract>
        <result action="numeric">
          <e type="operand">11.00</e>
        </result>
    </math>
    </region>
    <region left="20" top="7559" width="1560" height="27" color="#0f2a44" fontSize="12" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: bold; font-style: normal; font-size: 12px;">7.5  Can the tank make the gain, at every point of the line cycle?</p>
      </content>
    </text>
    </region>
    <region left="20" top="7594" width="470" height="35" color="#000000" fontSize="10" isBreakable="false">
