        <e type="operand">K.ring</e>
        <e type="operand">2</e>
        <e type="operator" args="2">*</e>
        <e type="operand">V.out</e>
        <e type="operator" args="2">*</e>
        <e type="operand">N.rect</e>
        <e type="operator" args="2">/</e>
        <e type="operator" args="2">:</e>
      </input>
        <contract>
          <e type="operand" style="unit">V</e>
