    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">[PICK] points along the sweep:</p>
      </content>
    </text>
    </region>
    <region left="510" top="7680" width="1080" height="35" color="#000000" bgColor="#ffff80" fontSize="8" isBreakable="false">
    <math>
      <input>
        <e type="operand">N.gc</e>
        <e type="operand">401</e>
        <e type="operator" args="2">:</e>
      </input>
    </math>
    </region>
    <region left="20" top="7723" width="1100" height="23" color="#6a6a6a" fontSize="9" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 9px;">[+] Q at the three phases - collapsed, Q(theta) = Q.pk sin(theta) squared</p>
      </content>
    </text>
    </region>
