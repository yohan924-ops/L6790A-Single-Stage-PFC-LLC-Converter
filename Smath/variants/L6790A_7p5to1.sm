        </contract>
        <result action="numeric">
          <e type="operand">31.00</e>
        </result>
    </math>
    </region>
    <region left="20" top="7398" width="470" height="35" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- Short-circuit inductance to specify:</p>
      </content>
    </text>
    </region>
    <region left="510" top="7398" width="1080" height="35" color="#000000" fontSize="8" isBreakable="false">
