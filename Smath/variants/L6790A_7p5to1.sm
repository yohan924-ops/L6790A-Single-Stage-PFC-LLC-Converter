        <e type="operator" args="2">/</e>
        <e type="operator" args="2">:</e>
      </input>
        <contract>
          <e type="operand" style="unit">kHz</e>
        </contract>
        <result action="numeric">
          <e type="operand">151.75</e>
        </result>
    </math>
    </region>
    <region left="20" top="7011" width="470" height="64" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- Normalized lower resonance:</p>
      </content>
    </text>
    </region>
    <region left="510" top="7011" width="1080" height="64" color="#000000" fontSize="8" isBreakable="false">
