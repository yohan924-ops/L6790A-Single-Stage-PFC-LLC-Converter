    <region left="18" top="5778" width="562" height="325" color="#000000" fontSize="10">
      <zedgraph width="552" height="317">
        <data encoding="base64"></data>
        <input>
          <e type="operand">Q.1</e>
          <e type="operand">Q.2</e>
          <e type="operand">Q.3</e>
