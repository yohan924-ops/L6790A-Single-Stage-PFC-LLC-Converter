          <e type="operand">1.0000</e>
        </result>
    </math>
    </region>
    <region left="20" top="3013" width="164" height="35" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="4">
      <input>
        <e type="operand">u.mT</e>
        <e type="operand">1</e>
        <e type="operand" style="unit">mT</e>
        <e type="operator" args="2">*</e>
        <e type="operator" args="2">:</e>
      </input>
        <contract>
          <e type="operand" style="unit">mT</e>
        </contract>
