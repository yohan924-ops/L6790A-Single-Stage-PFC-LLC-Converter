    <region left="20" top="1605" width="1560" height="23" color="#444444" fontSize="9" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 9px;">acos(z) = 2*atan( sqrt(1-z^2) / (1+z) )</p>
      </content>
    </text>
    </region>
