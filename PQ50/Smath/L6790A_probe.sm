  <regions type="content">
    <region left="20" top="30" width="1560" height="32" color="#000000" fontSize="15" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: bold; font-style: normal; font-size: 15px;">L6790A worksheet probes  -  the first red region names the cause</p>
      </content>
    </text>
    </region>
    <region left="20" top="76" width="1560" height="23" color="#444444" fontSize="9" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 9px;">Each probe uses one construct only. Compare with the expected value in the label. Only these functions are used anywhere: sqrt, abs, atan, cos, sin.</p>
      </content>
    </text>
    </region>
    <region left="20" top="123" width="1560" height="27" color="#0f2a44" fontSize="12" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: bold; font-style: normal; font-size: 12px;">P1  plain number, no unit                        expected 3.0000</p>
      </content>
    </text>
    </region>
    <region left="20" top="158" width="470" height="25" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- plain assignment:</p>
      </content>
    </text>
    </region>
    <region left="510" top="158" width="1080" height="35" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="4">
      <input>
        <e type="operand">p.1</e>
        <e type="operand">1</e>
        <e type="operand">2</e>
        <e type="operator" args="2">+</e>
        <e type="operator" args="2">:</e>
      </input>
        <result action="numeric">
          <e type="operand">3.0000</e>
        </result>
    </math>
    </region>
    <region left="20" top="217" width="1560" height="27" color="#0f2a44" fontSize="12" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: bold; font-style: normal; font-size: 12px;">P2  a value carrying a unit                      expected 90.0000 V</p>
      </content>
    </text>
    </region>
    <region left="20" top="252" width="470" height="25" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- unit on an input:</p>
      </content>
    </text>
    </region>
    <region left="510" top="252" width="1080" height="35" color="#000000" bgColor="#ffff80" fontSize="8" isBreakable="false">
    <math>
      <input>
        <e type="operand">p.2</e>
        <e type="operand">90</e>
        <e type="operand" style="unit">V</e>
        <e type="operator" args="2">*</e>
        <e type="operator" args="2">:</e>
      </input>
    </math>
    </region>
    <region left="20" top="311" width="1560" height="27" color="#0f2a44" fontSize="12" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: bold; font-style: normal; font-size: 12px;">P3  display unit via &lt;contract&gt;                  expected 150.0000 kHz</p>
      </content>
    </text>
    </region>
    <region left="20" top="346" width="470" height="25" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- contract to kHz:</p>
      </content>
    </text>
    </region>
    <region left="510" top="346" width="1080" height="35" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="4">
      <input>
        <e type="operand">p.3</e>
        <e type="operand">150000</e>
        <e type="operand" style="unit">Hz</e>
        <e type="operator" args="2">*</e>
        <e type="operator" args="2">:</e>
      </input>
        <contract>
          <e type="operand" style="unit">kHz</e>
        </contract>
        <result action="numeric">
          <e type="operand">150.0000</e>
        </result>
    </math>
    </region>
    <region left="20" top="405" width="1560" height="27" color="#0f2a44" fontSize="12" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: bold; font-style: normal; font-size: 12px;">P4  the resistance unit is lower-case ohm        expected 0.0240 ohm</p>
      </content>
    </text>
    </region>
    <region left="20" top="440" width="470" height="25" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- ohm (NOT Ohm):</p>
      </content>
    </text>
    </region>
    <region left="510" top="440" width="1080" height="35" color="#000000" bgColor="#ffff80" fontSize="8" isBreakable="false">
    <math>
      <input>
        <e type="operand">p.4</e>
        <e type="operand">0.024</e>
        <e type="operand" style="unit">ohm</e>
        <e type="operator" args="2">*</e>
        <e type="operator" args="2">:</e>
      </input>
    </math>
    </region>
    <region left="20" top="499" width="1560" height="27" color="#0f2a44" fontSize="12" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: bold; font-style: normal; font-size: 12px;">P5  mixed units must cancel                      expected 700.0000 W</p>
      </content>
    </text>
    </region>
    <region left="20" top="534" width="470" height="25" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- ohm*W / ohm:</p>
      </content>
    </text>
    </region>
    <region left="510" top="534" width="1080" height="53" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="4">
      <input>
        <e type="operand">p.5</e>
        <e type="operand">16.8</e>
        <e type="operand" style="unit">ohm</e>
        <e type="operator" args="2">*</e>
        <e type="operand" style="unit">W</e>
        <e type="operator" args="2">*</e>
        <e type="operand">p.4</e>
        <e type="operator" args="2">/</e>
        <e type="operator" args="2">:</e>
      </input>
        <contract>
          <e type="operand" style="unit">W</e>
        </contract>
        <result action="numeric">
          <e type="operand">700.0000</e>
        </result>
    </math>
    </region>
    <region left="20" top="611" width="1560" height="27" color="#0f2a44" fontSize="12" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: bold; font-style: normal; font-size: 12px;">P6  fractional power on a pure number            expected 1.4142</p>
      </content>
    </text>
    </region>
    <region left="20" top="646" width="470" height="25" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- sqrt:</p>
      </content>
    </text>
    </region>
    <region left="510" top="646" width="1080" height="44" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="4">
      <input>
        <e type="operand">p.6</e>
        <e type="operand">2</e>
        <e type="function" args="1">sqrt</e>
        <e type="operator" args="2">:</e>
      </input>
        <result action="numeric">
          <e type="operand">1.4142</e>
        </result>
    </math>
    </region>
    <region left="20" top="714" width="1560" height="27" color="#0f2a44" fontSize="12" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: bold; font-style: normal; font-size: 12px;">P7  a ratio of two unit-carrying values is unitless      expected 0.6000</p>
      </content>
    </text>
    </region>
    <region left="20" top="749" width="470" height="25" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- V / V:</p>
      </content>
    </text>
    </region>
    <region left="510" top="749" width="1080" height="53" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="4">
      <input>
        <e type="operand">p.7</e>
        <e type="operand">p.2</e>
        <e type="operand">150</e>
        <e type="operand" style="unit">V</e>
        <e type="operator" args="2">*</e>
        <e type="operator" args="2">/</e>
        <e type="operator" args="2">:</e>
      </input>
        <result action="numeric">
          <e type="operand">0.6000</e>
        </result>
    </math>
    </region>
    <region left="20" top="826" width="1560" height="27" color="#0f2a44" fontSize="12" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: bold; font-style: normal; font-size: 12px;">P8  atan   (arctan does NOT exist)               expected 0.7854</p>
      </content>
    </text>
    </region>
    <region left="20" top="861" width="470" height="25" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- atan(1):</p>
      </content>
    </text>
    </region>
    <region left="510" top="861" width="1080" height="39" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="4">
      <input>
        <e type="operand">p.8</e>
        <e type="operand">1</e>
        <e type="function" args="1">atan</e>
        <e type="operator" args="2">:</e>
      </input>
        <result action="numeric">
          <e type="operand">0.7854</e>
        </result>
    </math>
    </region>
    <region left="20" top="924" width="1560" height="27" color="#0f2a44" fontSize="12" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: bold; font-style: normal; font-size: 12px;">P9  abs on a PURE NUMBER  (never on a unit-carrying value)   expected 4.0000</p>
      </content>
    </text>
    </region>
    <region left="20" top="959" width="470" height="25" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- abs:</p>
      </content>
    </text>
    </region>
    <region left="510" top="959" width="1080" height="39" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="4">
      <input>
        <e type="operand">p.9</e>
        <e type="operand">3</e>
        <e type="operand">7</e>
        <e type="operator" args="2">-</e>
        <e type="function" args="1">abs</e>
        <e type="operator" args="2">:</e>
      </input>
        <result action="numeric">
          <e type="operand">4.0000</e>
        </result>
    </math>
    </region>
    <region left="20" top="1022" width="1560" height="27" color="#0f2a44" fontSize="12" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: bold; font-style: normal; font-size: 12px;">P10  min / max rewritten with abs                expected 3.0000 / 5.0000</p>
      </content>
    </text>
    </region>
    <region left="20" top="1057" width="1560" height="23" color="#444444" fontSize="9" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 9px;">min(a,b) = (a+b-|a-b|)/2      max(a,b) = (a+b+|a-b|)/2</p>
      </content>
    </text>
    </region>
    <region left="20" top="1088" width="470" height="25" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- min(3,5):</p>
      </content>
    </text>
    </region>
    <region left="510" top="1088" width="1080" height="57" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="4">
      <input>
        <e type="operand">p.10a</e>
        <e type="operand">3</e>
        <e type="operand">5</e>
        <e type="operator" args="2">+</e>
        <e type="operand">3</e>
        <e type="operand">5</e>
        <e type="operator" args="2">-</e>
        <e type="function" args="1">abs</e>
        <e type="operator" args="2">-</e>
        <e type="operand">2</e>
        <e type="operator" args="2">/</e>
        <e type="operator" args="2">:</e>
      </input>
        <result action="numeric">
          <e type="operand">3.0000</e>
        </result>
    </math>
    </region>
    <region left="20" top="1153" width="470" height="25" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- max(3,5):</p>
      </content>
    </text>
    </region>
    <region left="510" top="1153" width="1080" height="57" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="4">
      <input>
        <e type="operand">p.10b</e>
        <e type="operand">3</e>
        <e type="operand">5</e>
        <e type="operator" args="2">+</e>
        <e type="operand">3</e>
        <e type="operand">5</e>
        <e type="operator" args="2">-</e>
        <e type="function" args="1">abs</e>
        <e type="operator" args="2">+</e>
        <e type="operand">2</e>
        <e type="operator" args="2">/</e>
        <e type="operator" args="2">:</e>
      </input>
        <result action="numeric">
          <e type="operand">5.0000</e>
        </result>
    </math>
    </region>
    <region left="20" top="1234" width="1560" height="27" color="#0f2a44" fontSize="12" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: bold; font-style: normal; font-size: 12px;">P11  the same on values that carry a unit        expected 180.0000 V / 264.0000 V</p>
      </content>
    </text>
    </region>
    <region left="20" top="1269" width="470" height="25" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- a:</p>
      </content>
    </text>
    </region>
    <region left="510" top="1269" width="1080" height="35" color="#000000" bgColor="#ffff80" fontSize="8" isBreakable="false">
    <math>
      <input>
        <e type="operand">p.11a</e>
        <e type="operand">180</e>
        <e type="operand" style="unit">V</e>
        <e type="operator" args="2">*</e>
        <e type="operator" args="2">:</e>
      </input>
    </math>
    </region>
    <region left="20" top="1312" width="470" height="25" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- b:</p>
      </content>
    </text>
    </region>
    <region left="510" top="1312" width="1080" height="35" color="#000000" bgColor="#ffff80" fontSize="8" isBreakable="false">
    <math>
      <input>
        <e type="operand">p.11b</e>
        <e type="operand">264</e>
        <e type="operand" style="unit">V</e>
        <e type="operator" args="2">*</e>
        <e type="operator" args="2">:</e>
      </input>
    </math>
    </region>
    <region left="20" top="1355" width="470" height="25" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- min with the unit divided out:</p>
      </content>
    </text>
    </region>
    <region left="510" top="1355" width="1080" height="76" color="#000000" fontSize="8" isBreakable="false">
    <math decimalPlaces="4">
      <input>
        <e type="operand">p.11c</e>
        <e type="operand">p.11a</e>
        <e type="operand">p.11b</e>
        <e type="operator" args="2">+</e>
        <e type="operand">p.11a</e>
        <e type="operand" style="unit">V</e>
        <e type="operator" args="2">/</e>
        <e type="operand">p.11b</e>
        <e type="operand" style="unit">V</e>
        <e type="operator" args="2">/</e>
