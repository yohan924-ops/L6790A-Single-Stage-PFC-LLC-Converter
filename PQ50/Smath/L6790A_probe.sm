        <e type="operator" args="2">-</e>
        <e type="operand">2</e>
        <e type="operator" args="2">/</e>
        <e type="operator" args="2">:</e>
      </input>
        <contract>
          <e type="operand" style="unit">V</e>
        </contract>
        <result action="numeric">
          <e type="operand">180.0000</e>
        </result>
    </math>
    </region>
    <region left="20" top="1439" width="470" height="25" color="#000000" fontSize="10" isBreakable="false">
    <text lang="eng" fontFamily="Arial" fontSize="10">
      <content>
        <p style="font-weight: normal; font-style: normal; font-size: 10px;">- max with the unit divided out:</p>
      </content>
    </text>
    </region>
    <region left="510" top="1439" width="1080" height="76" color="#000000" fontSize="8" isBreakable="false">
