#  per-machine state written by guard.py and snapshot.py (as in the
#  top-level .gitignore, which is anchored to the original tree)
Design Guide/generators/.guard_stamp.json
Design Guide/generators/.snapshot_prev.json

#  leakage_fem.py caches its field solutions (keyed by the layout) so the AN
#  build does not re-solve them; one command regenerates it
Design Guide/generators/.fem_cache.json
