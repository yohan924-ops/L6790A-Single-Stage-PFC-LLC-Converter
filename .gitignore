__pycache__/
*.pyc
.eqcache/

#  an_locate.py --mark writes a ringed copy of the note beside the note
#  itself.  It is a 7 MB diagnostic that one command regenerates from the
#  real PDF, and committing it would double the note in every clone.
*_marked.pdf

#  per-machine state written by guard.py and snapshot.py (mtimes and the
#  last snapshot); committing them makes every clone disagree with itself
Design Guide/generators/.guard_stamp.json
Design Guide/generators/.snapshot_prev.json

#  leakage_fem.py caches its field solutions (keyed by the layout) so the AN
#  build does not re-solve them; one command regenerates it
Design Guide/generators/.fem_cache.json
